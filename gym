/* ---------- timer di recupero ---------- */
let audioCtx = null;
function beep(){
  try{
    audioCtx = audioCtx || new (window.AudioContext||window.webkitAudioContext)();
    [0,0.25,0.5].forEach(t => { const o = audioCtx.createOscillator(), g = audioCtx.createGain(); o.frequency.value = 880; o.connect(g); g.connect(audioCtx.destination); g.gain.setValueAtTime(0.0001, audioCtx.currentTime+t); g.gain.exponentialRampToValueAtTime(0.35, audioCtx.currentTime+t+0.02); g.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime+t+0.18); o.start(audioCtx.currentTime+t); o.stop(audioCtx.currentTime+t+0.2); });
  }catch(e){}
  try{ navigator.vibrate && navigator.vibrate([200,100,200,100,200]); }catch(e){}
}
function startTimer(sec){
  sec = sec || state.settings.rest;
  ui.timer = {end:Date.now()+sec*1000, total:sec, fin:false};
  try{ audioCtx = audioCtx || new (window.AudioContext||window.webkitAudioContext)(); if(audioCtx.state==='suspended') audioCtx.resume(); }catch(e){}
  tick();
}
function tick(){
  const bar = $('#timerbar'); const t = ui.timer; if(!t){ bar.hidden = true; return; }
  const left = Math.ceil((t.end-Date.now())/1000);
  bar.hidden = false;
  if(left>0){
    $('#tleft').textContent = Math.floor(left/60)+':'+z(left%60);
    $('#tprog').style.width = Math.max(0,(1-(t.end-Date.now())/1000/t.total)*100)+'%';
    $('#tlabel').textContent = 'Recupero'; bar.classList.remove('fin');
  } else {
    if(!t.fin){ t.fin = true; t.doneAt = Date.now(); beep(); }
    $('#tleft').textContent = '0:00'; $('#tprog').style.width = '100%'; $('#tlabel').textContent = 'Recupero finito'; bar.classList.add('fin');
    if(Date.now()-t.doneAt > 5000){ ui.timer = null; bar.hidden = true; }
  }
}
setInterval(tick, 250);

/* ---------- azioni ---------- */
function nextUndone(s, afterId){
  const ids = state.plan[s.day].filter(id => state.ex[id]); const i = ids.indexOf(afterId);
  const order = ids.slice(i+1).concat(ids.slice(0,i+1));
  return order.find(id => !(s.entries[id] && s.entries[id].done)) || null;
}
function mkDraft(ex, day){
  return {id:ex?ex.id:null, isNew:!ex, day, name:ex?ex.name:'', cat:ex?ex.cat:'Petto', type:ex?ex.type:'strength', sets:ex?ex.sets:2, reps:ex?ex.reps:'8-12', note:ex?(ex.note||''):'', p:ex?[...(ex.p||[])]:[], s:ex?[...(ex.s||[])]:[]};
}
function act(a, d, el){
  const s = curSession();
  switch(a){
    case 'tab': ui.tab = d.t; render(); window.scrollTo(0,0); return;
    case 'start': { const ss = openSession(d.day, ui.date); ui.sid = ss.id; const first = state.plan[d.day].find(id => state.ex[id] && !(ss.entries[id] && ss.entries[id].done)); ui.open = first || null; save(); render(); window.scrollTo(0,0); return; }
    case 'back': case 'finish': { const had = s && sessionHasData(s); closeSession(); if(a==='finish' && had) toast('Allenamento salvato'); render(); window.scrollTo(0,0); return; }
    case 'toggleOpen': ui.open = ui.open===d.ex ? null : d.ex; render(); return;
    case 'rest': state.settings.rest = +d.v; save(); render(); return;
    case 'timernow': startTimer(); return;
    case 't15': if(ui.timer){ ui.timer.end += 15000; ui.timer.total += 15; ui.timer.fin = false; tick(); } return;
    case 'tstop': ui.timer = null; tick(); return;
    case 'toggleSet': {
      const e = ensureEntry(s, d.ex), st = e.sets[+d.i]; st.done = !st.done;
      if(st.done){
        if(st.kg==='') st.kg = phSet(d.ex, s, +d.i, 'kg');
        if(st.reps==='') st.reps = phSet(d.ex, s, +d.i, 'reps');
        e.done = e.sets.every(x => x.done);
        if(e.done){ const n = nextUndone(s, d.ex); ui.open = n; } else startTimer();
        if(!e.done) {} else startTimer();
      } else e.done = false;
      save(); render(); return;
    }
    case 'toggleDone': {
      const e = ensureEntry(s, d.ex), ex = state.ex[d.ex]; e.done = !e.done;
      if(ex.type!=='cardio') e.sets.forEach(x => x.done = e.done);
      if(e.done){ fillFromLast(d.ex, s, e); ui.open = nextUndone(s, d.ex); }
      save(); render(); return;
    }
    case 'addSet': { const e = ensureEntry(s, d.ex); e.sets.push({kg:'',reps:'',done:false}); e.done = false; save(); render(); return; }
    case 'delSet': { const e = ensureEntry(s, d.ex); if(e.sets.length>1) e.sets.pop(); e.done = e.sets.every(x => x.done); save(); render(); return; }
    case 'calPrev': ui.cal.m--; if(ui.cal.m<0){ ui.cal.m=11; ui.cal.y--; } render(); return;
    case 'calNext': ui.cal.m++; if(ui.cal.m>11){ ui.cal.m=0; ui.cal.y++; } render(); return;
    case 'calSel': ui.calSel = d.d; render(); return;
    case 'openSess': { const x = state.sessions.find(q => q.id===d.id); if(x){ ui.date = x.date; ui.sid = x.id; ui.open = null; ui.tab = 'train'; render(); window.scrollTo(0,0); } return; }
    case 'progCat': ui.progCat = d.c; render(); return;
    case 'progOpen': ui.progOpen = ui.progOpen===d.ex ? null : d.ex; render(); return;
    case 'metric': ui.metric[d.ex] = d.m; render(); return;
    case 'addBody': {
      const date = $('#bDate').value || today(), w = num($('#bW').value), h = num($('#bH').value);
      if(w<20||w>300||h<100||h>230){ toast('Controlla peso e altezza'); return; }
      state.body.push({id:'b'+Date.now(), date, weight:w, height:h}); ui.cmp = {a:null,b:null}; save(); render(); toast('Misura salvata'); return;
    }
    case 'delBody': if(confirm('Eliminare questa misura?')){ state.body = state.body.filter(x => x.id!==d.id); save(); render(); } return;
    case 'info': ui.sheet = {type:'info', id:d.ex}; renderSheet(); return;
    case 'closeSheet': ui.sheet = null; ui.draft = null; render(); return;
    case 'saveVideo': { const v = $('#vidIn').value.trim(); if(v && !ytId(v)){ toast('Link YouTube non riconosciuto'); return; } state.ex[ui.sheet.id].video = v; save(); renderSheet(); toast(v?'Video salvato':'Video tolto'); return; }
    case 'clearVideo': state.ex[ui.sheet.id].video = ''; save(); renderSheet(); return;
    case 'addEx': ui.sheet = {type:'add', day:d.day}; renderSheet(); return;
    case 'newEx': ui.draft = mkDraft(null, d.day); ui.sheet = {type:'edit'}; renderSheet(); return;
    case 'pickEx': state.plan[d.day].push(d.ex); save(); ui.sheet = null; render(); return;
    case 'editEx': ui.draft = mkDraft(state.ex[d.ex], d.day); ui.sheet = {type:'edit'}; renderSheet(); return;
    case 'rmEx': if(confirm('Togliere questo esercizio dal giorno '+d.day+'? Lo storico resta salvato.')){ state.plan[d.day] = state.plan[d.day].filter(i => i!==d.ex); save(); render(); } return;
    case 'mvUp': case 'mvDown': { const arr = state.plan[d.day]; const i = arr.indexOf(d.ex); const j = a==='mvUp' ? i-1 : i+1; if(i>=0 && j>=0 && j<arr.length){ [arr[i],arr[j]] = [arr[j],arr[i]]; save(); render(); } return; }
    case 'mus': { const dr = ui.draft, g = d.g, o = g==='p'?'s':'p'; const i = dr[g].indexOf(d.k); if(i>=0) dr[g].splice(i,1); else { dr[g].push(d.k); const j = dr[o].indexOf(d.k); if(j>=0) dr[o].splice(j,1); } renderSheet(); return; }
    case 'saveEx': {
      const dr = ui.draft; if(!dr.name.trim()){ toast('Dai un nome all\'esercizio'); return; }
      const data = {name:dr.name.trim(), cat:dr.cat, type:dr.type, sets:Math.max(1,parseInt(dr.sets)||1), reps:dr.reps.trim(), note:dr.note.trim(), p:dr.p, s:dr.s};
      if(dr.isNew){ const id = 'x'+Date.now(); state.ex[id] = Object.assign({id, desc:'', cues:[], video:''}, data); state.plan[dr.day].push(id); }
      else Object.assign(state.ex[dr.id], data);
      save(); ui.sheet = null; ui.draft = null; render(); toast('Esercizio salvato'); return;
    }
    case 'export': {
      const blob = new Blob([JSON.stringify(state,null,1)], {type:'application/json'}); const a2 = document.createElement('a');
      a2.href = URL.createObjectURL(blob); a2.download = 'palestra-backup-'+today()+'.json'; document.body.appendChild(a2); a2.click(); a2.remove(); setTimeout(() => URL.revokeObjectURL(a2.href), 2000); return;
    }
    case 'reset': if(confirm('Cancellare tutti i dati, scheda e storico compresi? Non si può annullare.')){ state = fresh(); ui.sid = null; save(); render(); toast('Dati cancellati'); } return;
  }
}

document.addEventListener('click', e => {
  const t = e.target.closest('[data-act]');
  if(t){ if(t.disabled) return; act(t.dataset.act, t.dataset, t); return; }
  if(e.target.id==='sheet'){ ui.sheet = null; ui.draft = null; render(); }
});
document.addEventListener('input', e => {
  const t = e.target;
  if(t.dataset.f){
    const s = curSession(); if(!s) return;
    const en = ensureEntry(s, t.dataset.ex);
    if(t.dataset.i !== undefined) en.sets[+t.dataset.i][t.dataset.f] = t.value; else en[t.dataset.f] = t.value;
    save();
  } else if(t.dataset.df && ui.draft){ ui.draft[t.dataset.df] = t.value; }
});
document.addEventListener('change', e => {
  const t = e.target;
  if(t.id==='dateIn'){ ui.date = t.value || today(); render(); }
  else if(t.dataset.df==='type' && ui.draft){ ui.draft.type = t.value; renderSheet(); }
  else if(t.dataset.sel){ ui.cmp[t.dataset.sel] = t.value; render(); }
  else if(t.dataset.set==='start'){ state.settings.start = t.value ? mondayOf(t.value) : ''; save(); render(); }
  else if(t.dataset.set==='rest'){ state.settings.rest = +t.value; save(); }
  else if(t.id==='importIn' && t.files[0]){
    const r = new FileReader();
    r.onload = () => {
      try{
        const o = JSON.parse(r.result);
        if(!o || !o.ex || !o.plan || !Array.isArray(o.sessions)) throw new Error('formato');
        if(!confirm('Sostituire i dati attuali con quelli del backup?')) return;
        o.body = o.body||[]; o.settings = Object.assign({rest:90,start:''}, o.settings||{});
        state = o; state.sessions = state.sessions.filter(sessionHasData); ui.sid = null; save(); render(); toast('Backup importato');
      }catch(err){ toast('File di backup non valido'); }
    };
    r.readAsText(t.files[0]);
  }
});

render();
if('serviceWorker' in navigator){ window.addEventListener('load', () => navigator.serviceWorker.register('./sw.js').catch(() => {})); }
</script>
</body>
</html>
