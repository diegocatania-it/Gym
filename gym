    E('spalle',68,72,12,13) +
    M('dorsali','M97 102 Q84 92 76 80 Q70 102 80 132 L97 140Z') +
    `<g fill="${col('lombari')}"><rect x="90" y="140" width="20" height="24" rx="6"/></g>` +
    E('tricipiti',56,106,8,19) + E('avambracci',49,152,7,20) +
    E('glutei',86,188,15,16) +
    M('femorali','M78 206 Q74 232 80 262 L96 262 Q100 232 98 206Z') +
