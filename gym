/* ---------- figura corpo parametrica ---------- */
function bodyFig(weight, height, color){
  const bmi = Math.max(15, Math.min(45, weight/Math.pow(height/100,2)));
  const k = Math.max(0.7, Math.min(1.75, 0.72 + (bmi-17)*0.05));
  const ks = 1+(k-1)*0.6, kc = 1+(k-1)*0.85, kw = 1+(k-1)*1.5, kh = 1+(k-1)*1.0, kt = 1+(k-1)*0.95, ka = 1+(k-1)*0.55;
  const S=40*ks, C=34*kc, W=26*kw, Hh=33*kh, nk=6*(1+(k-1)*0.3);
  const torso = `M${-S} 54 Q0 46 ${S} 54 C${S+2} 70 ${C+3} 80 ${C} 92 C${C-4} 112 ${W+2} 122 ${W} 138 C${W+4} 152 ${Hh} 160 ${Hh} 176 L${Hh-2} 192 L${-(Hh-2)} 192 L${-Hh} 176 C${-Hh} 160 ${-(W+4)} 152 ${-W} 138 C${-(W+2)} 122 ${-(C-4)} 112 ${-C} 92 C${-(C+3)} 80 ${-(S+2)} 70 ${-S} 54Z`;
  const aw = 11*ka, fw = 9*ka, tw = 25*kt, cw = 15*(1+(k-1)*0.5);
  const lx = Hh*0.5, kx = Hh*0.46+2, ax = Hh*0.4;
  const sc = Math.max(0.7, Math.min(1.12, height/180));
  return `<svg viewBox="0 0 200 420" role="img" aria-label="Sagoma del corpo">
  <g transform="translate(100,404) scale(${sc.toFixed(3)}) translate(0,-360)" fill="${color}" stroke="${color}" stroke-linecap="round" stroke-linejoin="round">
   <ellipse cx="0" cy="20" rx="13" ry="16" stroke="none"/><rect x="${-nk}" y="34" width="${nk*2}" height="16" stroke="none"/>
   <path d="${torso}" stroke="none"/>
   <line x1="${S+1}" y1="62" x2="${S+7}" y2="128" stroke-width="${aw}"/><line x1="${-S-1}" y1="62" x2="${-S-7}" y2="128" stroke-width="${aw}"/>
   <line x1="${S+7}" y1="128" x2="${S+10}" y2="190" stroke-width="${fw}"/><line x1="${-S-7}" y1="128" x2="${-S-10}" y2="190" stroke-width="${fw}"/>
   <line x1="${lx}" y1="188" x2="${kx}" y2="262" stroke-width="${tw}"/><line x1="${-lx}" y1="188" x2="${-kx}" y2="262" stroke-width="${tw}"/>
   <line x1="${kx}" y1="262" x2="${ax}" y2="344" stroke-width="${cw}"/><line x1="${-kx}" y1="262" x2="${-ax}" y2="344" stroke-width="${cw}"/>
   <ellipse cx="${ax}" cy="352" rx="10" ry="6" stroke="none"/><ellipse cx="${-ax}" cy="352" rx="10" ry="6" stroke="none"/>
  </g></svg>`;
}

/* ---------- viste ---------- */
function viewTrain(){
  const s = curSession(); if(s) return viewSession(s);
  const w = weekNo(ui.date);
  const wk = sessionsInWeek(w);
  const base = (w%2===1) ? ['A','B','A'] : ['B','A','B'];
  const slots = base.map((l,i) => wk[i] ? {l:wk[i].day, done:true} : {l, done:false});
  const dayCard = d => {
    const ss = state.sessions.find(x => x.date===ui.date && x.day===d);
    const n = state.plan[d].length; const done = ss ? state.plan[d].filter(id => ss.entries[id] && ss.entries[id].done).length : 0;
    return `<button class="big ${d.toLowerCase()}" data-act="start" data-day="${d}"><span class="l">${d}</span><span><span class="t" style="display:block">Giorno ${d}</span><span class="m">${ss && sessionHasData(ss) ? `In corso: ${done} di ${n} fatti` : `${n} esercizi`}</span></span></button>`;
  };
  return `<header class="top"><h1>Palestra</h1><p class="sub">${niceDate(today())}</p></header>
  <p class="remind">${esc(lastText())}</p>
  <section class="card"><div class="weekhead"><h2>Settimana ${w}</h2><span class="muted">schema ${base.join(' ')}</span></div>
    <div class="slots">${slots.map(x => `<div class="slot ${x.done?'done':''}">${x.l}</div>`).join('')}</div></section>
  <label class="field"><span>Data dell'allenamento</span><input type="date" id="dateIn" value="${ui.date}"></label>
  <div class="pick">${dayCard('A')}${dayCard('B')}</div>`;
}
function viewSession(s){
  const ids = state.plan[s.day].filter(id => state.ex[id]);
  const done = ids.filter(id => s.entries[id] && s.entries[id].done).length;
  const rest = state.settings.rest;
  return `<div class="sesshead"><button class="btn small" data-act="back">Indietro</button><div style="text-align:right"><h2>Giorno ${s.day}</h2><p class="muted" style="font-size:14px">${niceDate(s.date)}</p></div></div>
  <div class="row between"><b>${done} di ${ids.length} fatti</b><span class="muted" style="font-size:13px">Settimana ${weekNo(s.date)}</span></div>
  <div class="bar"><i style="width:${ids.length?done/ids.length*100:0}%"></i></div>
  <div class="rest"><span class="lab">Recupero</span>${[60,90,120,180].map(v => `<button class="pill ${rest===v?'on':''}" data-act="rest" data-v="${v}">${v} s</button>`).join('')}<button class="pill" data-act="timernow">Avvia</button></div>
  ${ids.map(id => exCard(s,id)).join('')}
  <button class="btn primary block" style="margin-top:8px" data-act="finish">Fine allenamento</button>`;
}
function exCard(s, id){
  const ex = state.ex[id]; const e = ensureEntry(s, id); const open = ui.open===id;
  let body = '';
  if(open){
    if(ex.type==='cardio'){
      body = `<p class="last">${esc(lastSummary(id,s))}</p>
      <div class="cardio">
        <div><label>Minuti</label><input class="num" type="number" inputmode="decimal" step="0.5" data-ex="${id}" data-f="min" value="${esc(e.min)}" placeholder="${esc(lastEntry(id,s)?.min ?? '')}"></div>
        <div><label>Velocità km/h</label><input class="num" type="number" inputmode="decimal" step="0.1" data-ex="${id}" data-f="speed" value="${esc(e.speed)}" placeholder="${esc(lastEntry(id,s)?.speed ?? '')}"></div>
        <div><label>Incl. / resist.</label><input class="num" type="number" inputmode="decimal" step="0.5" data-ex="${id}" data-f="incl" value="${esc(e.incl)}" placeholder="${esc(lastEntry(id,s)?.incl ?? '')}"></div>
      </div>
      <div class="setbtns"><button class="btn small ${e.done?'':'primary'}" data-act="toggleDone" data-ex="${id}">${e.done?'Segna da fare':'Segna come fatto'}</button></div>`;
    } else {
      body = `<p class="last">${esc(lastSummary(id,s))}</p>
      <div class="setgrid"><span class="h">Serie</span><span class="h">kg</span><span class="h">Ripetizioni</span><span></span></div>
      ${e.sets.map((st,i) => `<div class="setgrid"><span class="n">${i+1}</span>
        <input class="num" type="number" inputmode="decimal" step="0.5" data-ex="${id}" data-i="${i}" data-f="kg" value="${esc(st.kg)}" placeholder="${esc(phSet(id,s,i,'kg')||'kg')}" aria-label="kg serie ${i+1}">
        <input class="num" type="number" inputmode="numeric" data-ex="${id}" data-i="${i}" data-f="reps" value="${esc(st.reps)}" placeholder="${esc(phSet(id,s,i,'reps')||'rip')}" aria-label="ripetizioni serie ${i+1}">
        <button class="chk sm ${st.done?'on':''}" data-act="toggleSet" data-ex="${id}" data-i="${i}" aria-label="Serie ${i+1} fatta">${CHECK}</button></div>`).join('')}
      <div class="setbtns"><button class="btn small" data-act="addSet" data-ex="${id}">Aggiungi serie</button>${e.sets.length>1?`<button class="btn small" data-act="delSet" data-ex="${id}">Togli serie</button>`:''}</div>
      <p class="note">Se tocchi la spunta con i campi vuoti, uso i valori dell'ultima volta.</p>`;
    }
  }
