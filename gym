function entryLine(id, e){
  const ex = state.ex[id];
  if(ex.type==='cardio'){ const p=[]; if(e.min!=='') p.push(e.min+' min'); if(e.speed!=='') p.push(e.speed+' km/h'); if(e.incl!=='') p.push('incl. '+e.incl); return p.join(', ')||'Fatto'; }
