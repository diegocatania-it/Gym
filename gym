<!doctype html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#ECEEE8">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Palestra">
<link rel="manifest" href="manifest.webmanifest">
<link rel="apple-touch-icon" href="icon-192.png">
<link rel="icon" href="icon-192.png">
<title>Palestra</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#ECEEE8; --card:#F8F9F5; --ink:#151B18; --muted:#667069; --line:#D6DAD2;
  --accent:#2F3BFF; --accent-soft:#B9BEFF; --on-accent:#FFFFFF; --lime:#B8F25B; --on-lime:#151B18;
  --danger:#C2362B; --mbase:#CFD4CA; --mbody:#DFE3D9;
}
@media (prefers-color-scheme:dark){
  :root{
    --bg:#111513; --card:#1A201D; --ink:#EEF1EA; --muted:#8E978F; --line:#2B332F;
    --accent:#8A92FF; --accent-soft:#3B4194; --on-accent:#10131F; --danger:#FF7A6E;
    --mbase:#38413C; --mbody:#262D29;
  }
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;background:var(--bg);color:var(--ink);font-family:'Archivo',system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;font-size:16px;line-height:1.4}
body{padding-top:env(safe-area-inset-top)}
body.lock{overflow:hidden}
#app{max-width:520px;margin:0 auto;padding:18px 16px calc(100px + env(safe-area-inset-bottom))}
h1,h2,h3{margin:0;font-stretch:75%;font-variation-settings:"wdth" 75;font-weight:800;letter-spacing:-.01em;line-height:1.05}
h1{font-size:38px}
h2{font-size:24px}
h3{font-size:19px}
p{margin:0}
.muted{color:var(--muted)}
.sub{color:var(--muted);margin-top:4px}
button{font:inherit;color:inherit;cursor:pointer}
input,select{font:inherit;font-size:16px;color:var(--ink)}
.top{margin-bottom:14px}
.remind{display:block;padding:12px 14px;border-left:6px solid var(--lime);background:var(--card);border-radius:4px 12px 12px 4px;font-weight:600;margin:0 0 14px}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:14px;margin-bottom:12px}
.row{display:flex;align-items:center;gap:10px}
.between{justify-content:space-between}
.grow{flex:1;min-width:0}
.field{display:block;margin:0 0 14px}
.field>span{display:block;font-size:13px;color:var(--muted);margin-bottom:4px}
.field input,.field select,.inp{width:100%;height:46px;padding:0 12px;border:1px solid var(--line);border-radius:10px;background:var(--bg)}
.btn{height:46px;padding:0 18px;border-radius:12px;border:1.5px solid var(--ink);background:transparent;font-weight:700}
.btn.primary{background:var(--ink);color:var(--bg)}
.btn.accent{background:var(--accent);border-color:var(--accent);color:var(--on-accent)}
.btn.small{height:36px;padding:0 12px;font-size:14px;border-radius:10px}
.btn.danger{border-color:var(--danger);color:var(--danger)}
.btn.block{width:100%}
.pill{height:36px;padding:0 14px;border-radius:999px;border:1px solid var(--line);background:transparent;font-weight:600;font-size:14px;white-space:nowrap}
.pill.on{background:var(--ink);color:var(--bg);border-color:var(--ink)}
.pills{display:flex;gap:8px;overflow-x:auto;padding:2px 0 10px;margin:0 -16px;padding-left:16px;padding-right:16px;scrollbar-width:none}
.pills::-webkit-scrollbar{display:none}
.wrapPills{display:flex;flex-wrap:wrap;gap:8px}

/* settimana */
.weekhead{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:10px}
.slots{display:flex;gap:8px}
.slot{width:52px;height:52px;border-radius:12px;display:grid;place-items:center;font-stretch:75%;font-variation-settings:"wdth" 75;font-weight:800;font-size:26px;border:1.5px dashed var(--line);color:var(--muted)}
.slot.done{background:var(--lime);color:var(--on-lime);border:1.5px solid var(--lime)}

/* scelta giorno */
.pick{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:6px}
.big{border:0;border-radius:18px;padding:14px 16px 16px;text-align:left;min-height:190px;display:flex;flex-direction:column;justify-content:space-between}
.big.a{background:var(--accent);color:var(--on-accent)}
.big.b{background:var(--ink);color:var(--bg)}
.big .l{font-stretch:62%;font-variation-settings:"wdth" 62;font-weight:900;font-size:112px;line-height:.85;letter-spacing:-.02em}
.big .t{font-weight:800;font-size:18px}
.big .m{font-size:13px;opacity:.8}

/* sessione */
.sesshead{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}
.bar{height:8px;border-radius:99px;background:var(--line);overflow:hidden;margin:10px 0 14px}
.bar i{display:block;height:100%;background:var(--lime);border-radius:99px;transition:width .25s}
.rest{display:flex;align-items:center;gap:8px;margin-bottom:14px;flex-wrap:wrap}
.rest .lab{font-size:13px;color:var(--muted);margin-right:2px}
.ex{background:var(--card);border:1px solid var(--line);border-radius:14px;margin-bottom:10px;overflow:hidden}
.ex.done{border-color:var(--lime);box-shadow:inset 6px 0 0 var(--lime)}
.exhead{display:flex;align-items:center;gap:12px;padding:12px 12px 12px 14px}
.chk{width:44px;height:44px;border-radius:50%;border:2px solid var(--ink);background:transparent;display:grid;place-items:center;flex:none;padding:0}
.chk svg{width:22px;height:22px;opacity:0;stroke:var(--on-lime);fill:none;stroke-width:3.2;stroke-linecap:round;stroke-linejoin:round}
.chk.on{background:var(--lime);border-color:var(--lime)}
.chk.on svg{opacity:1}
.chk.sm{width:40px;height:40px}
.exmain{flex:1;min-width:0;text-align:left;background:none;border:0;padding:0}
.exmain b{display:block;font-size:17px;line-height:1.2}
.exmain span{font-size:13px;color:var(--muted)}
.iconbtn{width:40px;height:40px;border-radius:10px;border:1px solid var(--line);background:transparent;display:grid;place-items:center;flex:none;padding:0}
.iconbtn svg{width:20px;height:20px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.exbody{padding:0 14px 14px;border-top:1px solid var(--line)}
.last{font-size:13px;color:var(--muted);padding:10px 0}
.setgrid{display:grid;grid-template-columns:44px 1fr 1fr 44px;gap:8px;align-items:center;margin-bottom:8px}
.setgrid .h{font-size:12px;color:var(--muted);text-align:center}
.setgrid .n{font-stretch:75%;font-variation-settings:"wdth" 75;font-weight:800;font-size:20px;text-align:center}
.num{width:100%;height:48px;border:1px solid var(--line);border-radius:10px;background:var(--bg);text-align:center;font-size:20px;font-weight:700;padding:0 4px}
.num::placeholder{color:var(--muted);opacity:.55;font-weight:500}
.cardio{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.cardio label{font-size:12px;color:var(--muted);display:block;text-align:center;margin-bottom:4px}
.note{font-size:13px;color:var(--muted);margin-top:6px}
.setbtns{display:flex;gap:8px;margin-top:6px}

/* timer */
#timerbar{position:fixed;left:12px;right:12px;bottom:calc(72px + env(safe-area-inset-bottom));max-width:496px;margin:0 auto;background:var(--ink);color:var(--bg);border-radius:14px;padding:10px 12px;display:flex;align-items:center;gap:10px;z-index:20;overflow:hidden}
#timerbar[hidden]{display:none}
#tleft{font-stretch:75%;font-variation-settings:"wdth" 75;font-weight:800;font-size:30px;min-width:70px}
#tprog{position:absolute;left:0;bottom:0;height:4px;background:var(--lime);width:0}
#timerbar.fin{background:var(--lime);color:var(--on-lime)}
#timerbar .btn{height:34px;border-color:currentColor;font-size:14px;padding:0 12px}

/* nav */
nav{position:fixed;left:0;right:0;bottom:0;background:var(--card);border-top:1px solid var(--line);display:grid;grid-template-columns:repeat(5,1fr);padding:6px 6px calc(6px + env(safe-area-inset-bottom));z-index:30}
nav button{background:none;border:0;display:flex;flex-direction:column;align-items:center;gap:3px;font-size:11px;font-weight:600;color:var(--muted);padding:4px 0}
nav button svg{width:24px;height:24px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
nav button.on{color:var(--accent)}

/* calendario */
.calhead{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}
.calgrid{display:grid;grid-template-columns:repeat(7,1fr);gap:4px}
.dow{font-size:12px;color:var(--muted);text-align:center;padding-bottom:2px}
.day{aspect-ratio:1/1.1;border-radius:10px;border:1px solid transparent;background:var(--card);padding:4px 5px;text-align:left;display:flex;flex-direction:column;justify-content:space-between;font-weight:600;font-size:14px}
.day.empty{background:transparent;border:0}
.day.today{border-color:var(--ink)}
.day.sel{outline:2px solid var(--accent);outline-offset:1px}
.day .bd{display:flex;gap:2px}
.day .bd i{font-style:normal;font-stretch:75%;font-variation-settings:"wdth" 75;font-weight:800;font-size:13px;background:var(--lime);color:var(--on-lime);border-radius:4px;padding:0 5px;line-height:1.3}
.sessline{padding:8px 0;border-top:1px solid var(--line);font-size:14px}
.sessline:first-child{border-top:0}

/* progressi */
.prog{padding:0;overflow:hidden}
.progrow{display:grid;grid-template-columns:1fr 96px auto;align-items:center;gap:10px;width:100%;background:none;border:0;padding:12px 14px;text-align:left}
.progrow b{display:block;line-height:1.2}
.progrow small{color:var(--muted)}
.pval{text-align:right;font-weight:800;font-size:17px;font-stretch:75%;font-variation-settings:"wdth" 75;min-width:60px}
.pval small{display:block;font-size:12px;font-weight:600;font-stretch:100%}
.up{color:#2d8a3e}
.down{color:var(--danger)}
@media (prefers-color-scheme:dark){.up{color:#7bdc8a}}
.chartbox{padding:0 14px 14px;border-top:1px solid var(--line)}
.chartbox svg{width:100%;height:auto;display:block;margin-top:8px}
.cathead{margin:18px 0 8px}

/* corpo */
.figs{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.figs figure{margin:0;text-align:center}
.figs svg{width:100%;height:auto;background:var(--card);border:1px solid var(--line);border-radius:14px}
.figs figcaption{font-size:13px;margin-top:6px}
.form3{display:grid;grid-template-columns:1.3fr 1fr 1fr;gap:8px;margin-bottom:10px}
.form3 .field{margin:0}
.hist{display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-top:1px solid var(--line);font-size:15px}
.hist:first-child{border-top:0}

/* scheda */
.plrow{display:flex;align-items:center;gap:8px;padding:10px 0;border-top:1px solid var(--line)}
.plrow:first-of-type{border-top:0}
.plrow b{display:block;line-height:1.2}
.plrow span{font-size:13px;color:var(--muted)}
.mini{display:flex;gap:6px}

/* sheet */
#sheet{position:fixed;inset:0;z-index:50;background:rgba(10,14,12,.55);display:flex;align-items:flex-end;justify-content:center}
#sheet[hidden]{display:none}
#sheetpanel{background:var(--bg);width:100%;max-width:520px;max-height:92vh;border-radius:22px 22px 0 0;display:flex;flex-direction:column;overflow:hidden}
#sheethead{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;padding:16px 16px 8px}
#sheetbody{overflow-y:auto;padding:4px 16px calc(24px + env(safe-area-inset-bottom));-webkit-overflow-scrolling:touch}
.legend{display:flex;gap:14px;font-size:13px;margin:8px 0 12px;flex-wrap:wrap}
.legend i{display:inline-block;width:12px;height:12px;border-radius:3px;margin-right:6px;vertical-align:-1px}
.cues{padding-left:18px;margin:8px 0 14px}
.cues li{margin-bottom:4px}
.video{position:relative;aspect-ratio:16/9;border-radius:12px;overflow:hidden;background:#000;margin:8px 0}
.video iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
.warn{border-left:5px solid var(--lime);padding:8px 12px;background:var(--card);border-radius:4px 10px 10px 4px;margin:10px 0;font-size:14px}
.toast{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(84px + env(safe-area-inset-bottom));background:var(--ink);color:var(--bg);padding:10px 16px;border-radius:99px;font-weight:600;z-index:60;font-size:14px}
a{color:var(--accent)}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>
<main id="app"></main>
<div id="timerbar" hidden>
  <span id="tleft">0:00</span>
  <span class="grow muted" id="tlabel" style="color:inherit;opacity:.8;font-size:14px">Recupero</span>
  <button class="btn" data-act="t15">+15 s</button>
  <button class="btn" data-act="tstop">Stop</button>
  <span id="tprog"></span>
</div>
<nav id="nav"></nav>
<div id="sheet" hidden>
  <div id="sheetpanel" role="dialog" aria-modal="true">
    <div id="sheethead"></div>
    <div id="sheetbody"></div>
  </div>
</div>

<script>
'use strict';
/* ---------- dati di base ---------- */
const LS = 'palestra.v1';
const CATS = ['Cardio','Petto','Schiena','Spalle','Braccia','Gambe','Core'];
const MUSCLES = {pettorali:'Pettorali',spalle:'Spalle',bicipiti:'Bicipiti',tricipiti:'Tricipiti',avambracci:'Avambracci',addominali:'Addominali',obliqui:'Obliqui',quadricipiti:'Quadricipiti',trapezio:'Trapezio',dorsali:'Dorsali',lombari:'Lombari',glutei:'Glutei',femorali:'Femorali',polpacci:'Polpacci'};

const DEF_EX = [
 {id:'panca-piana',name:'Panca piana manubri',cat:'Petto',type:'strength',sets:2,reps:'8-12',p:['pettorali'],s:['spalle','tricipiti'],
  desc:`Spinta orizzontale con i manubri. Allena soprattutto il petto, con spalle anteriori e tricipiti che aiutano.`,
  cues:[`Scapole indietro e in basso, ben appoggiate alla panca`,`Piedi saldi a terra`,`Gomiti a circa 45 gradi dal busto, non larghi`,`Scendi controllato e spingi senza far battere i manubri`]},
 {id:'rematore-appoggiato',name:'Rematore con petto appoggiato alla panca',cat:'Schiena',type:'strength',sets:2,reps:'8-12',p:['dorsali','trapezio'],s:['bicipiti','spalle','avambracci'],
  desc:`Tirata con il petto sostenuto dalla panca, così la schiena lavora senza dover reggere il busto. Allena dorsali e parte alta della schiena.`,
  cues:[`Petto fermo sulla panca, collo in linea con la schiena`,`Porta i gomiti verso i fianchi`,`Stringi le scapole in alto per un istante`,`Scendi lento fino ad avere le braccia quasi stese`]},
 {id:'goblet-squat',name:'Goblet squat verso la panca',cat:'Gambe',type:'strength',sets:2,reps:'8-10',p:['quadricipiti','glutei'],s:['femorali','addominali'],note:`Solo se il piede resta tranquillo`,
  desc:`Squat con un manubrio tenuto al petto, scendendo fino a sfiorare la panca. Allena cosce e glutei, il core tiene il busto in asse.`,
  cues:[`Manubrio vicino allo sterno, gomiti verso il basso`,`Piedi larghi come le spalle`,`Siediti verso la panca tenendo il busto alto`,`Spingi con tutto il piede per risalire`]},
 {id:'shoulder-press',name:'Shoulder press seduto',cat:'Spalle',type:'strength',sets:2,reps:'8-12',p:['spalle'],s:['tricipiti','trapezio'],
  desc:`Spinta verticale con i manubri. Allena le spalle, con tricipiti e parte alta del trapezio di supporto.`,
  cues:[`Schiena appoggiata e addome in tensione`,`Parti con i manubri all'altezza delle orecchie`,`Spingi in alto senza inarcare la schiena`,`Scendi controllato`]},
 {id:'curl',name:'Curl manubri',cat:'Braccia',type:'strength',sets:2,reps:'10-15',p:['bicipiti'],s:['avambracci'],
  desc:`Flessione del gomito con i manubri. Isola i bicipiti, aiutati dagli avambracci.`,
  cues:[`Gomiti vicini ai fianchi e fermi`,`Sali senza dondolare il busto`,`Scendi lento fino al braccio quasi disteso`]},
 {id:'dead-bug',name:'Dead bug',cat:'Core',type:'strength',sets:2,reps:'8-10 per lato',p:['addominali'],s:['obliqui'],
  desc:`Esercizio a terra per il core: braccio e gamba opposti si allungano mentre la zona lombare resta ferma. Allena gli addominali profondi.`,
  cues:[`Schiena bassa aderente al pavimento`,`Muovi braccio e gamba opposti, lentamente`,`Espira mentre allunghi`,`Se la schiena si stacca, riduci l'ampiezza`]},
 {id:'cyclette',name:'Cyclette',cat:'Cardio',type:'cardio',sets:1,reps:'5-10 min facili',p:['quadricipiti','polpacci'],s:['glutei','femorali'],
  desc:`Cardio a basso impatto per scaldarsi o chiudere la seduta. Lavorano soprattutto cosce e polpacci.`,
  cues:[`Sella all'altezza dell'anca`,`Ritmo facile: riesci a parlare senza fiatone`,`Schiena lunga e spalle rilassate`]},
 {id:'panca-inclinata',name:'Panca inclinata manubri',cat:'Petto',type:'strength',sets:2,reps:'8-12',p:['pettorali'],s:['spalle','tricipiti'],
  desc:`Come la panca piana ma con lo schienale inclinato: sposta il lavoro sulla parte alta del petto.`,
  cues:[`Inclinazione moderata, intorno ai 30 gradi`,`Scapole stabili sulla panca`,`Manubri sopra la parte alta del petto`,`Gomiti non troppo larghi`]},
 {id:'rematore-un-braccio',name:'Rematore con manubrio a un braccio',cat:'Schiena',type:'strength',sets:2,reps:'8-12 per lato',p:['dorsali'],s:['trapezio','bicipiti','spalle','avambracci'],
  desc:`Tirata con un manubrio alla volta, con una mano e un ginocchio sulla panca. Allena i dorsali un lato per volta.`,
  cues:[`Schiena piatta, parallela al pavimento`,`Tira il gomito verso l'anca, non verso la spalla`,`Evita di ruotare il busto`,`Scendi lento fino a braccio disteso`]},
 {id:'hip-thrust',name:'Hip thrust sulla panca',cat:'Gambe',type:'strength',sets:2,reps:'10-15',p:['glutei'],s:['femorali','quadricipiti'],
  desc:`Spinta del bacino con la schiena alta appoggiata alla panca. Allena soprattutto i glutei.`,
  cues:[`Scapole sul bordo della panca`,`Piedi sotto le ginocchia a fine salita`,`Mento verso il petto, bacino che sale`,`Stringi i glutei in alto senza inarcare la zona lombare`]},
 {id:'alzate-laterali',name:'Alzate laterali',cat:'Spalle',type:'strength',sets:2,reps:'12-15',p:['spalle'],s:['trapezio'],
  desc:`Alzate dei manubri di lato fino all'altezza delle spalle. Allena il deltoide laterale, quello che allarga la spalla.`,
  cues:[`Gomiti leggermente flessi`,`Sali fino all'altezza delle spalle, non oltre`,`Niente slancio con il busto`,`Scendi lento`]},
 {id:'tricipiti-testa',name:'Estensioni tricipiti sopra la testa',cat:'Braccia',type:'strength',sets:2,reps:'10-15',p:['tricipiti'],s:['spalle'],
  desc:`Un manubrio tenuto con due mani dietro la testa: distendi i gomiti verso l'alto. Allena i tricipiti, in particolare la parte lunga.`,
  cues:[`Gomiti stretti, puntati verso l'alto`,`Muovi solo l'avambraccio`,`Scendi fin dove senti allungare, senza forzare la spalla`]},
 {id:'reverse-crunch',name:'Reverse crunch',cat:'Core',type:'strength',sets:2,reps:'10-15',p:['addominali'],s:['obliqui'],
  desc:`Da sdraiato porti le ginocchia verso il petto sollevando il bacino. Allena la parte bassa degli addominali.`,
  cues:[`Schiena aderente al pavimento o alla panca`,`Porta su il bacino, senza dondolare`,`Scendi lentamente, senza far cadere le gambe`]}
];

function fresh(){
  const ex = {}; DEF_EX.forEach(e => ex[e.id] = JSON.parse(JSON.stringify(e)));
  return {v:1, ex,
    plan:{A:['panca-piana','rematore-appoggiato','goblet-squat','shoulder-press','curl','dead-bug','cyclette'],
          B:['panca-inclinata','rematore-un-braccio','hip-thrust','alzate-laterali','tricipiti-testa','reverse-crunch','cyclette']},
    sessions:[], body:[], settings:{rest:90, start:''}};
}
let state = load();
function load(){
  try{
    const raw = localStorage.getItem(LS);
    if(raw){ const s = JSON.parse(raw); if(s && s.ex && s.plan && Array.isArray(s.sessions)){ s.body = s.body||[]; s.settings = Object.assign({rest:90,start:''}, s.settings||{}); s.sessions = s.sessions.filter(sessionHasData); return s; } }
  }catch(e){}
  return fresh();
}
function save(){ try{ localStorage.setItem(LS, JSON.stringify(state)); }catch(e){} }

/* ---------- utilita ---------- */
const $ = (s, r=document) => r.querySelector(s);
const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const z = n => String(n).padStart(2,'0');
const fmt = d => d.getFullYear()+'-'+z(d.getMonth()+1)+'-'+z(d.getDate());
const today = () => fmt(new Date());
const parse = s => { const [y,m,d] = s.split('-').map(Number); return new Date(y,m-1,d); };
const daysBetween = (a,b) => Math.round((parse(b)-parse(a))/864e5);
const mondayOf = s => { const d = parse(s); d.setDate(d.getDate() - ((d.getDay()+6)%7)); return fmt(d); };
const cap = s => s.charAt(0).toUpperCase()+s.slice(1);
const niceDate = s => cap(parse(s).toLocaleDateString('it-IT',{weekday:'long',day:'numeric',month:'long'}));
const num = v => { const n = parseFloat(String(v ?? '').replace(',','.')); return isFinite(n) ? n : 0; };
const fnum = n => Number(n).toLocaleString('it-IT',{maximumFractionDigits:1});
const sortedSessions = () => state.sessions.slice().sort((a,b) => a.date===b.date ? String(a.id).localeCompare(String(b.id)) : a.date.localeCompare(b.date));
const ICON = {
  train:'<path d="M6 7v10M3 9v6M18 7v10M21 9v6M6 12h12"/>',
  cal:'<rect x="3.5" y="5" width="17" height="15" rx="2"/><path d="M3.5 10h17M8 3v4M16 3v4"/>',
  prog:'<path d="M4 19V5M4 19h16M8 15l4-4 3 3 5-6"/>',
  body:'<circle cx="12" cy="5.5" r="2.5"/><path d="M12 9v6M7.5 11.5L12 10l4.5 1.5M9.5 21l2.5-6 2.5 6"/>',
  plan:'<path d="M5 6h14M5 12h14M5 18h9"/>',
  info:'<circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.5v.01"/>',
  up:'<path d="M6 15l6-6 6 6"/>', down:'<path d="M6 9l6 6 6-6"/>', edit:'<path d="M4 20h4L19 9l-4-4L4 16v4z"/>', del:'<path d="M5 7h14M10 7V4h4v3M7 7l1 13h8l1-13"/>',
  left:'<path d="M15 6l-6 6 6 6"/>', right:'<path d="M9 6l6 6-6 6"/>', close:'<path d="M6 6l12 12M18 6L6 18"/>'
};
const ico = k => `<svg viewBox="0 0 24 24" aria-hidden="true">${ICON[k]}</svg>`;
const CHECK = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>';

/* ---------- stato interfaccia ---------- */
const nowD = new Date();
const ui = {tab:'train', date:today(), sid:null, open:null, cal:{y:nowD.getFullYear(), m:nowD.getMonth()}, calSel:today(),
  progCat:'Tutti', progOpen:null, metric:{}, sheet:null, draft:null, timer:null, cmp:{a:null,b:null}};

/* ---------- sessioni ---------- */
function sessionHasData(s){
  return Object.values(s.entries||{}).some(e => e.done || (e.sets||[]).some(x => x.done || (x.kg!==''&&x.kg!=null) || (x.reps!==''&&x.reps!=null)) || ['min','speed','incl'].some(k => e[k]!==undefined && e[k]!=='' && e[k]!==null));
}
const curSession = () => ui.sid ? state.sessions.find(s => s.id===ui.sid) : null;
function openSession(day, date){
  let s = state.sessions.find(x => x.date===date && x.day===day);
  if(!s){ s = {id:date+'-'+day, date, day, entries:{}}; state.sessions.push(s); }
  return s;
}
function closeSession(){
  const s = curSession();
  if(s && !sessionHasData(s)) state.sessions = state.sessions.filter(x => x !== s);
  ui.sid = null; ui.open = null; save();
}
function ensureEntry(s, id){
  const ex = state.ex[id]; let e = s.entries[id];
  if(!e) e = s.entries[id] = {done:false};
  if(ex.type==='cardio'){ e.min ??= ''; e.speed ??= ''; e.incl ??= ''; }
  else if(!Array.isArray(e.sets)){ e.sets = Array.from({length:Math.max(1,+ex.sets||1)}, () => ({kg:'',reps:'',done:false})); }
  return e;
}
function entryHasData(e){ return e && (e.done || (e.sets||[]).some(x => x.done || x.kg!=='' || x.reps!=='') || ['min','speed','incl'].some(k => e[k]!==undefined && e[k]!=='')); }
function lastEntry(id, s){
  const list = sortedSessions().reverse();
  for(const x of list){ if(s && x.id===s.id) continue; if(s && x.date > s.date) continue; const e = x.entries[id]; if(entryHasData(e)) return e; }
  return null;
}
function phSet(id, s, i, f){
  const last = lastEntry(id, s); if(!last || !last.sets || !last.sets.length) return '';
  const st = last.sets[i] || last.sets[last.sets.length-1]; return st[f] ?? '';
}
function fillFromLast(id, s, e){
  const ex = state.ex[id]; const last = lastEntry(id, s); if(!last) return;
  if(ex.type==='cardio'){ ['min','speed','incl'].forEach(k => { if(e[k]==='' && last[k]!==undefined) e[k] = last[k]; }); }
  else (e.sets||[]).forEach((st,i) => { if(st.kg==='') st.kg = phSet(id,s,i,'kg'); if(st.reps==='') st.reps = phSet(id,s,i,'reps'); });
}
function lastSummary(id, s){
  const ex = state.ex[id]; const l = lastEntry(id, s); if(!l) return 'Prima volta con questo esercizio';
  if(ex.type==='cardio'){
    const p = []; if(l.min!=='') p.push(l.min+' min'); if(l.speed!=='') p.push(l.speed+' km/h'); if(l.incl!=='') p.push('incl. '+l.incl);
    return 'Ultima volta: '+(p.join(', ')||'segnato come fatto');
  }
  const sets = (l.sets||[]).filter(x => x.kg!==''||x.reps!=='').map(x => (x.kg!==''?x.kg+' kg':'corpo libero')+' x '+(x.reps!==''?x.reps:'-'));
  return 'Ultima volta: '+(sets.join(', ')||'segnato come fatto');
}
function targetText(ex){ return ex.type==='cardio' ? ex.reps : `${ex.sets} x ${ex.reps}`; }

/* ---------- settimane ---------- */
function startMonday(){
  const c = []; if(state.settings.start) c.push(state.settings.start);
  const f = sortedSessions().find(sessionHasData); if(f) c.push(f.date);
  if(!c.length) c.push(today());
  return mondayOf(c.sort()[0]);
}
const weekNo = date => Math.floor(daysBetween(startMonday(), date)/7)+1;
const sessionsInWeek = w => sortedSessions().filter(s => sessionHasData(s) && weekNo(s.date)===w);
function lastText(){
  const done = sortedSessions().filter(sessionHasData);
  if(!done.length) return 'Ancora nessun allenamento registrato. Scegli A o B per iniziare.';
  const s = done[done.length-1]; const d = daysBetween(s.date, today());
  const wd = cap(parse(s.date).toLocaleDateString('it-IT',{weekday:'long'}));
  if(d===0) return `Oggi hai fatto ${s.day}`;
  if(d===1) return `Ieri hai fatto ${s.day}`;
  if(d>=2 && d<=6) return `${wd} scorso hai fatto ${s.day}`;
  return `${wd} ${parse(s.date).toLocaleDateString('it-IT',{day:'numeric',month:'long'})} hai fatto ${s.day}`;
}

/* ---------- metriche e grafici ---------- */
function metricVal(ex, e, m){
  if(!e) return null;
  if(ex.type==='cardio'){
    if(!e.done) return null;
    const v = num(e[m]); return v>0 ? v : null;
  }
  const ds = (e.sets||[]).filter(x => x.done); if(!ds.length) return null;
  let v = 0;
  if(m==='kg') v = Math.max(...ds.map(x => num(x.kg)));
  else if(m==='vol') v = ds.reduce((a,x) => a + num(x.kg)*num(x.reps), 0);
  else v = ds.reduce((a,x) => a + num(x.reps), 0);
  return v>0 ? v : null;
}
function metricsFor(ex){ return ex.type==='cardio' ? [['min','Minuti'],['speed','Velocità'],['incl','Incl. / resist.']] : [['kg','Peso max'],['vol','Volume'],['reps','Ripetizioni']]; }
const unitOf = m => ({kg:'kg',vol:'kg totali',reps:'rip.',min:'min',speed:'km/h',incl:''}[m]);
function defaultMetric(id){
  const ex = state.ex[id]; if(ex.type==='cardio') return 'min';
  return state.sessions.some(s => metricVal(ex, s.entries[id], 'kg')) ? 'kg' : 'reps';
}
function series(id, m){
  const ex = state.ex[id]; const by = {};
  for(const s of state.sessions){
    const v = metricVal(ex, s.entries[id], m); if(v==null) continue;
    const w = weekNo(s.date); by[w] = Math.max(by[w] ?? -Infinity, v);
  }
  return Object.keys(by).map(Number).sort((a,b) => a-b).map(w => ({w, v:by[w]}));
}
function chart(data, unit){
  if(!data.length) return '<p class="muted" style="padding-top:10px">Nessun dato ancora. Segna una serie come fatta e il grafico compare qui.</p>';
  const W=340,H=176,L=40,R=18,T=18,B=28;
  const xs = data.map(d => d.w), vs = data.map(d => d.v);
  let x0 = Math.min(...xs), x1 = Math.max(...xs); if(x0===x1){ x0-=1; x1+=1; }
  let lo = Math.min(...vs), hi = Math.max(...vs);
  if(lo===hi){ lo = lo*0.8; hi = (hi*1.2)||1; } else { const p=(hi-lo)*0.2; lo = Math.max(0, lo-p); hi += p; }
  const X = w => L + (w-x0)/(x1-x0)*(W-L-R), Y = v => T + (1-(v-lo)/(hi-lo))*(H-T-B);
  let g = '';
  [lo, (lo+hi)/2, hi].forEach(v => { g += `<line x1="${L}" x2="${W-R}" y1="${Y(v)}" y2="${Y(v)}" stroke="var(--line)"/><text x="${L-6}" y="${Y(v)+4}" text-anchor="end" font-size="11" fill="var(--muted)">${fnum(v)}</text>`; });
  const step = Math.ceil(data.length/7);
  data.forEach((d,i) => { if(i%step===0 || i===data.length-1) g += `<text x="${X(d.w)}" y="${H-8}" text-anchor="middle" font-size="11" fill="var(--muted)">S${d.w}</text>`; });
  const path = data.map((d,i) => (i?'L':'M')+X(d.w).toFixed(1)+' '+Y(d.v).toFixed(1)).join(' ');
  const dots = data.map((d,i) => { const last = i===data.length-1; return `<circle cx="${X(d.w)}" cy="${Y(d.v)}" r="${last?6:4}" fill="${last?'var(--lime)':'var(--card)'}" stroke="var(--accent)" stroke-width="2.5"/>`; }).join('');
  const lastD = data[data.length-1];
  const lab = `<text x="${Math.min(X(lastD.w), W-R-4)}" y="${Y(lastD.v)-12}" text-anchor="middle" font-size="13" font-weight="700" fill="var(--ink)">${fnum(lastD.v)} ${unit}</text>`;
  return `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Andamento settimanale">${g}<path d="${path}" fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round"/>${dots}${lab}</svg>`;
}
function spark(data){
  const W=96,H=30; if(data.length<2) return `<svg viewBox="0 0 ${W} ${H}" width="96" height="30"><line x1="2" x2="${W-2}" y1="${H/2}" y2="${H/2}" stroke="var(--line)" stroke-dasharray="3 4"/>${data.length?`<circle cx="${W-6}" cy="${H/2}" r="3.5" fill="var(--accent)"/>`:''}</svg>`;
  const vs = data.map(d => d.v); const lo = Math.min(...vs), hi = Math.max(...vs);
  const X = i => 4 + i/(data.length-1)*(W-8), Y = v => hi===lo ? H/2 : 4 + (1-(v-lo)/(hi-lo))*(H-8);
  const p = data.map((d,i) => (i?'L':'M')+X(i).toFixed(1)+' '+Y(d.v).toFixed(1)).join(' ');
  return `<svg viewBox="0 0 ${W} ${H}" width="96" height="30"><path d="${p}" fill="none" stroke="var(--accent)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="${X(data.length-1)}" cy="${Y(vs[vs.length-1])}" r="3.5" fill="var(--accent)"/></svg>`;
}

