  const svg = inner => `<svg viewBox="0 0 200 376" role="img" aria-hidden="true">${inner}</svg>`;
  return `<div class="figs"><figure>${svg(front)}<figcaption>Davanti</figcaption></figure><figure>${svg(back)}<figcaption>Dietro</figcaption></figure></div>`;
